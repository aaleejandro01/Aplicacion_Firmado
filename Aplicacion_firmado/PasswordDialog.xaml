<Window x:Class="Aplicacion_firmado.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmación de Seguridad" Height="220" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" 
        WindowStyle="ToolWindow" Background="#F8F9FA">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="ACCESO RESTRINGIDO" FontWeight="Bold" Foreground="#D32F2F" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="Introduce la contraseña de Administrador para generar un nuevo par de claves criptográficas." TextWrapping="Wrap" TextAlignment="Center" Foreground="#555555" Margin="0,0,0,15"/>

            <PasswordBox x:Name="TxtPassword" Height="28" Padding="5" Margin="0,0,0,20"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="CANCELAR" Height="35" Background="#D0D0D0" FontWeight="Bold" Click="BtnCancelar_Click" Cursor="Hand"/>
                <Button Grid.Column="2" Content="CONFIRMAR" Height="35" Background="#2C3E50" Foreground="White" FontWeight="Bold" Click="BtnAceptar_Click" Cursor="Hand"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
